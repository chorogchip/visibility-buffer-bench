{
  "$schema": "../../schema.json",
  "schema_version": 1,
  "id": "real_scenes/legacy_sponza_geometry_sweep_refined",
  "title": "Legacy Sponza Geometry Sweep Refined",
  "summary": "legacy sponza geometry sweep refined",
  "tags": [
    "real_scenes"
  ],
  "reproduction": {
    "fidelity": "adapted",
    "legacy_source": "datas/experiments_2/succeed/ex9_scene_geom_ex2/scene_geom_ex2.json",
    "note": "Legacy schema was completed with explicit current defaults where required."
  },
  "executable": "@executable/release",
  "repeat": 1,
  "keep_individual_csv": true,
  "base": {
    "_renderer_variant": 1,
    "variable": 0,
    "to_use_scene": true,
    "to_load_texture": false,
    "use_vfc": true,
    "scene_path": "@scene/sponza",
    "warmup_frames": 60,
    "measure_frames": 2400,
    "vsync": false,
    "camera_mode": 2,
    "camera_filepath": "@camera/standard_camera",
    "camera_keyframe_interval": 10,
    "to_set_start_frame": false,
    "key_frame": 0,
    "profile_window_frames": 10,
    "window_width": 1920,
    "window_height": 1080,
    "seed": 0,
    "camera_pos_x": 0.0,
    "camera_pos_y": 0.0,
    "camera_pos_z": -10.0,
    "camera_lookat_x": 0.0,
    "camera_lookat_y": 0.0,
    "camera_lookat_z": 0.0,
    "camera_near_z": 0.1,
    "camera_far_z": 1000.0,
    "camera_fov": 0.785,
    "object_count": 1,
    "material_count": 1,
    "geometry_count": 1,
    "overdraw_count": 0,
    "to_remain_only_in_camera": false,
    "z_min": -1.0,
    "z_max": 1.0,
    "xy_minmax": 1.0,
    "radius": 0.5,
    "geometry_div": 1,
    "gbuffer_cnt": 1,
    "texture_count": 1,
    "texture_size": 256,
    "texture_sampling_count": 1,
    "_alu_calc_count": 100,
    "visibility_debug_mode": 0,
    "donut_linear_gbuffer": false,
    "scene_variant": 0,
    "scene_importer": "assimp",
    "capture_frames": false,
    "capture_stride": 1,
    "capture_fps": 60,
    "material_assign_strategy": 0,
    "material_assign_max_open": 255,
    "material_assign_locality": 1.0,
    "material_assign_diversity": 1.0
  },
  "sweep": {
    "renderer_variant": [
      1,
      2,
      3,
      4,
      5,
      6
    ],
    "alu_calc_count": [
      1,
      2,
      4
    ]
  },
  "analysis": {
    "plots": [
      {
        "id": "total_time",
        "type": "total",
        "x": "auto",
        "metric": "total_time_median_ms",
        "title": "Median GPU time"
      },
      {
        "id": "pass_breakdown",
        "type": "pass_breakdown",
        "title": "GPU pass breakdown"
      }
    ]
  }
}
