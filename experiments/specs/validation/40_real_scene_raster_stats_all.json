{
  "$schema": "../../schema.json",
  "schema_version": 1,
  "id": "validation/40_real_scene_raster_stats_all",
  "title": "40 Real Scene Raster Stats All",
  "summary": "6개 실제 scene의 전체 raster workload 통계를 수집한다. 각 frame별 visible triangle, fragment, overdraw, quad waste 및 quad efficiency를 기록한다.",
  "tags": [
    "validation",
    "runnable_now"
  ],
  "reproduction": {
    "fidelity": "exact",
    "legacy_source": "datas/experiments_4/40_real_scene_raster_stats_all/40_real_scene_raster_stats_all.json"
  },
  "executable": "@executable/release",
  "repeat": 1,
  "timeout_seconds": 28800,
  "keep_individual_csv": true,
  "base": {
    "renderer_variant": 10,
    "variable": 0,
    "to_use_scene": true,
    "to_load_texture": false,
    "use_vfc": true,
    "scene_variant": 0,
    "scene_importer": "assimp",
    "scene_path": "@scene/sponza",
    "warmup_frames": 60,
    "measure_frames": 2500,
    "vsync": false,
    "camera_mode": 2,
    "camera_filepath": "@camera/standard_camera",
    "camera_keyframe_interval": 10,
    "to_set_start_frame": false,
    "key_frame": 0,
    "profile_window_frames": 60,
    "capture_frames": false,
    "capture_stride": 1,
    "capture_fps": 60,
    "window_width": 1280,
    "window_height": 720,
    "seed": 0,
    "material_assign_strategy": 1,
    "material_assign_max_open": 255,
    "material_assign_locality": 1.0,
    "material_assign_diversity": 1.0,
    "geometry_div": 1,
    "camera_pos_x": 0.0,
    "camera_pos_y": 0.0,
    "camera_pos_z": -10.0,
    "camera_lookat_x": 0.0,
    "camera_lookat_y": 0.0,
    "camera_lookat_z": 0.0,
    "camera_near_z": 0.1,
    "camera_far_z": 1000.0,
    "camera_fov": 0.785,
    "object_count": 1,
    "material_count": 1,
    "geometry_count": 1,
    "overdraw_count": 0,
    "to_remain_only_in_camera": false,
    "z_min": -1.0,
    "z_max": 1.0,
    "xy_minmax": 1.0,
    "radius": 0.5,
    "gbuffer_cnt": 1,
    "texture_count": 1,
    "texture_size": 256,
    "texture_sampling_count": 1,
    "alu_calc_count": 100
  },
  "samples": [
    {
      "variable": 0,
      "scene_path": "@scene/sponza",
      "camera_filepath": "@camera/standard_camera",
      "measure_frames": 2500
    },
    {
      "variable": 1,
      "scene_path": "@scene/bistro",
      "camera_filepath": "@camera/standard_camera_bistro",
      "measure_frames": 5500
    },
    {
      "variable": 2,
      "scene_path": "@scene/bistro_interior",
      "camera_filepath": "@camera/standard_camera_bistroin",
      "measure_frames": 1734
    },
    {
      "variable": 3,
      "scene_path": "@scene/san_miguel",
      "camera_filepath": "@camera/standard_camera_sanmiguel",
      "measure_frames": 2689
    },
    {
      "variable": 4,
      "scene_path": "@scene/sun_temple",
      "camera_filepath": "@camera/standard_camera_suntemple",
      "measure_frames": 2976
    },
    {
      "variable": 5,
      "scene_path": "@scene/zero_day",
      "camera_filepath": "@camera/standard_camera_zeroday",
      "measure_frames": 834
    }
  ],
  "analysis": {
    "plots": [
      {
        "id": "total_time",
        "type": "total",
        "x": "auto",
        "metric": "total_time_median_ms",
        "title": "Median GPU time"
      },
      {
        "id": "pass_breakdown",
        "type": "pass_breakdown",
        "title": "GPU pass breakdown"
      }
    ]
  }
}
