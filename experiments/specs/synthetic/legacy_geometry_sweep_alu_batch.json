{
  "$schema": "../../schema.json",
  "schema_version": 1,
  "id": "synthetic/legacy_geometry_sweep_alu_batch",
  "title": "Legacy Geometry Sweep Alu Batch",
  "summary": "legacy geometry sweep alu batch",
  "tags": [
    "synthetic"
  ],
  "reproduction": {
    "fidelity": "adapted",
    "legacy_source": "datas/experiments_2/succeed/ex3_geometry_sweep_alu_batch/geometry_sweep_alu_batch.json",
    "note": "Legacy schema was completed with explicit current defaults where required. Removed arguments no longer accepted by ProgramArgument: renderer_variant_name, run_current_time, sort_type."
  },
  "executable": "@executable/release",
  "repeat": 1,
  "keep_individual_csv": false,
  "base": {
    "_renderer_variant": 1,
    "variable": 1,
    "to_use_scene": false,
    "scene_path": "@scene/sponza",
    "warmup_frames": 100,
    "measure_frames": 60,
    "window_width": 1280,
    "window_height": 720,
    "seed": 0,
    "camera_pos_x": 0.0,
    "camera_pos_y": 0.0,
    "camera_pos_z": -10.0,
    "camera_lookat_x": 0.0,
    "camera_lookat_y": 0.0,
    "camera_lookat_z": 0.0,
    "camera_near_z": 0.1,
    "camera_far_z": 1000.0,
    "camera_fov": 0.11,
    "_object_count": 1,
    "_material_count": 10,
    "geometry_count": 1,
    "_sort_type": 0,
    "z_min": -1.0,
    "z_max": 1.0,
    "xy_minmax": 1.0,
    "radius": 0.5,
    "geometry_div": 4,
    "gbuffer_cnt": 1,
    "texture_count": 1,
    "texture_size": 256,
    "texture_sampling_count": 1,
    "alu_calc_count": 50,
    "visibility_debug_mode": 0,
    "donut_linear_gbuffer": false,
    "to_load_texture": false,
    "use_vfc": false,
    "scene_variant": 0,
    "scene_importer": "assimp",
    "vsync": false,
    "camera_mode": 0,
    "camera_filepath": "@camera/standard_camera",
    "camera_keyframe_interval": 10,
    "to_set_start_frame": false,
    "key_frame": 0,
    "profile_window_frames": 10,
    "capture_frames": false,
    "capture_stride": 1,
    "capture_fps": 60,
    "material_assign_strategy": 0,
    "material_assign_max_open": 255,
    "material_assign_locality": 1.0,
    "material_assign_diversity": 1.0,
    "to_remain_only_in_camera": false
  },
  "sweep": {
    "material_count": [
      10,
      20,
      30
    ],
    "object_count": [
      4,
      16,
      64,
      256,
      1024,
      4096,
      16384
    ],
    "renderer_variant": [
      1,
      2,
      4
    ]
  },
  "analysis": {
    "plots": [
      {
        "id": "total_time",
        "type": "total",
        "x": "auto",
        "metric": "total_time_median_ms",
        "title": "Median GPU time"
      },
      {
        "id": "pass_breakdown",
        "type": "pass_breakdown",
        "title": "GPU pass breakdown"
      }
    ]
  }
}
